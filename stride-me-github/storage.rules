rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos de tes exercices : chacun écrit dans son dossier, images de 2 Mo maximum.
    match /exercises/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Photos des exercices partagés (ajoutées depuis l'espace admin de l'appli).
    match /shared/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
